# =============================================================================
# UAE Compliance Copilot — configuration
# Copy this file to .env and fill in values. All variables have sensible
# defaults for local/offline use (Ollama) except where noted.
# =============================================================================

# --- Default LLM provider (used by any agent without a role-specific override) ---
# One of: openai | anthropic | ollama | azure | groq | custom
LLM_PROVIDER=ollama

# Model name string understood by the chosen provider,
# e.g. "gpt-4o-mini" (openai), "claude-sonnet-5" (anthropic), "llama3.1" (ollama)
LLM_MODEL=llama3.1

# Base URL override. Required for ollama/custom, optional override for others.
# Ollama default local server:
LLM_BASE_URL=http://localhost:11434

# API key. Not required for ollama. Leave blank for local-only usage.
LLM_API_KEY=

# --- Optional per-role overrides for HYBRID mode -----------------------------
# Example hybrid setup: orchestrator reasons with a stronger cloud model while
# specialist sub-agents run cheaply on a local model.
#
# ORCHESTRATOR_LLM_PROVIDER=anthropic
# ORCHESTRATOR_LLM_MODEL=claude-sonnet-5
# ORCHESTRATOR_LLM_API_KEY=sk-ant-...
#
# SUBAGENT_LLM_PROVIDER=ollama
# SUBAGENT_LLM_MODEL=llama3.1
# SUBAGENT_LLM_BASE_URL=http://localhost:11434

# --- Runtime behavior ---------------------------------------------------------
# Max retry attempts per LLM call before an agent reports a structured failure
LLM_MAX_RETRIES=3

# Request timeout (seconds) per LLM call
LLM_TIMEOUT_SECONDS=30

# Soft token budget for a single pipeline run (Supervisor checks this before
# delegating to remaining agents; 0 disables the check)
MAX_TOKENS_PER_RUN=0

# Sanctions/PEP fuzzy-match threshold (0-100, higher = stricter match required)
SANCTIONS_MATCH_THRESHOLD=85

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
